{
  "name": "omnirag-web",
  "private": true,
  "version": "0.3.1",
  "description": "OmniRAG web app (Vite + React + Tailwind CSS + shadcn/ui). Built into src/omnirag/server/static.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
