# The committed web build is generated by `pnpm --dir web build`; keep it byte-identical
# across platforms so CI can check it is up to date.
src/omnirag/server/static/** -text linguist-generated=true
web/pnpm-lock.yaml linguist-generated=true
site/pnpm-lock.yaml linguist-generated=true
# Web sources keep LF everywhere so a build on any OS reproduces the committed output.
web/** text=auto eol=lf
site/** text=auto eol=lf
